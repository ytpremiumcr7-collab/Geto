APP_NAME=GEOINT Platform
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://geoint:CHANGE_ME_DEV_ONLY@localhost:5432/geoint
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

NATS_URL=nats://localhost:4222
NATS_STREAM=GEOINT
NATS_MAX_AGE_SECONDS=604800

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_DEV_ONLY
MINIO_SECRET_KEY=CHANGE_ME_DEV_ONLY
MINIO_BUCKET_RAW=geoint-raw
MINIO_SECURE=false

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_INTERVAL_SECONDS=30
OPENSKY_TIMEOUT_SECONDS=20

CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_INTERVAL_SECONDS=7200
CELESTRAK_GROUP=STATIONS

USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_INTERVAL_SECONDS=60

FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_BBOX=-180,-90,180,90
FIRMS_DAY_RANGE=1
FIRMS_INTERVAL_SECONDS=600

AVIATION_WEATHER_BASE_URL=https://aviationweather.gov/api/data
AVIATION_WEATHER_USER_AGENT=GEOINT-Platform/2.0 contact@example.com
AVIATION_WEATHER_INTERVAL_SECONDS=300

COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/
COPERNICUS_COLLECTION=sentinel-2-l2a
COPERNICUS_INTERVAL_SECONDS=3600

DEFAULT_AOI_WEST=-118
DEFAULT_AOI_SOUTH=14
DEFAULT_AOI_EAST=-86
DEFAULT_AOI_NORTH=33

OTEL_ENABLED=false
OTEL_SERVICE_NAME=geoint-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

PROMETHEUS_ENABLED=true


# Auth (production: strong secret, AUTH_DISABLED=false)
AUTH_DISABLED=false
JWT_SECRET=  # REQUIRED: run `openssl rand -hex 32` — weak defaults are rejected on encode AND decode
JWT_ALGORITHM=HS256
JWT_ISSUER=geoint-platform
JWT_AUDIENCE=geoint-api
JWT_EXPIRES_MINUTES=60
AUTH_BOOTSTRAP_SECRET=
API_KEYS=
DEV_TENANT_ID=default

OBSERVATIONS_RETENTION_DAYS=90
RAW_PAYLOAD_RETENTION_DAYS=30

# OpenSky: solo habilitar ingestión si uso autorizado (investigación / permiso comercial)
OPENSKY_INGESTION_ENABLED=false


# ADS-B local (readsb/dump1090)
READSB_AIRCRAFT_JSON_PATH=/run/readsb/aircraft.json

# AIS histórico (CSV/GeoJSON MarineCadastre u otro)
AIS_FILE_PATH=/data/ais/latest.csv

NEXRAD_DEFAULT_SITE=KTLX
GOES_SATELLITE=goes16
GOES_PRODUCT=ABI-L2-CMIPF
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://localhost:8123

# API keys hasheadas (preferido). Generar: python -m scripts.hash_api_key SECRET tenant operator
API_KEY_HASHES=

# OIDC / RS256
# JWT_ALGORITHM=RS256
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json
# JWT_ISSUER=https://your-idp/
# JWT_AUDIENCE=geoint-api
# JWT_TENANT_CLAIM=tenant_id

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

METRICS_PUBLIC=false
RATE_LIMIT_FAIL_OPEN=false

# ---------------------------------------------------------------------------
# EDGE / CORS (P0)
# Development: leave CORS_ORIGINS empty → allows *
# Production/staging: REQUIRED comma-separated https origins (no *)
# CORS_ORIGINS=https://app.example.com,https://ops.example.com
# TRUSTED_HOSTS=api.example.com,localhost
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_HTTP=false
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AUTH — production REQUIRES OIDC/JWKS (P0)
# APP_ENV=production|staging → process refuses to start without:
#   JWT_JWKS_URL=https://your-idp/.well-known/jwks.json
#   JWT_ALGORITHM=RS256
#   CORS_ORIGINS=https://…
#   strong DB/MinIO secrets (no change-me)
# Break-glass only: ALLOW_HS256_IN_PRODUCTION=true + strong JWT_SECRET
# JWT_JWKS_URL=
# JWT_ALGORITHM=RS256
# ALLOW_HS256_IN_PRODUCTION=false
# API_KEY_HASHES=   # sha256hex:tenant:roles;…  (python -m scripts.hash_api_key)
# ---------------------------------------------------------------------------

# Alert notifier (SMTP) — optional; webhook channels only need channel.config.url
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ALERT_NOTIFIER_POLL_SECONDS=2
ALERT_NOTIFIER_BATCH_SIZE=20


# --- Alert notifier health (orchestrator) ---
ALERT_NOTIFIER_HEALTH_PORT=8081
ALERT_NOTIFIER_READY_MAX_AGE_S=60
ALERT_NOTIFIER_HEARTBEAT_PATH=/tmp/geoint_alert_notifier_heartbeat

# --- OIDC production ---
# JWT_ALGORITHM=RS256
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json
# JWT_ISSUER=https://your-idp/
# JWT_AUDIENCE=geoint-api

# --- ClickHouse analytics ---
# CLICKHOUSE_ENABLED=true
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_PASSWORD=...
