# GEOINT staging — copy to .env.staging and fill secrets
#   cp .env.staging.example .env.staging

APP_ENV=staging
AUTH_DISABLED=false

# --- OIDC / JWKS (required when APP_ENV=staging|production) ---
# Option A — real IdP (Keycloak / Auth0 / Cognito):
JWT_ALGORITHM=RS256
JWT_JWKS_URL=https://YOUR_IDP/.well-known/jwks.json
JWT_ISSUER=https://YOUR_IDP/
JWT_AUDIENCE=geoint-api
JWT_TENANT_CLAIM=tenant_id

# Option B — lab only: local JWKS from scripts/dev_jwks_server.py
# JWT_JWKS_URL=http://host.docker.internal:9090/jwks.json
# JWT_ISSUER=http://localhost:9090/
# (API container may need extra_hosts for host.docker.internal)

# Never use weak HS256 in staging unless break-glass:
# ALLOW_HS256_IN_PRODUCTION=true
# JWT_SECRET=<openssl rand -hex 32>

# --- Database / infra ---
POSTGRES_USER=geoint
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG
POSTGRES_DB=geoint
DATABASE_URL=postgresql+asyncpg://geoint:CHANGE_ME_STRONG_PG@postgres:5432/geoint

REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

MINIO_ROOT_USER=geointminio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=geointminio
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO

# --- CORS (explicit origins, no *) ---
CORS_ORIGINS=https://staging.geoint.example,http://localhost:5173
# Required when any CORS origin uses http:// (lab only)
CORS_ALLOW_HTTP=true

# --- ClickHouse analytics ---
CLICKHOUSE_ENABLED=true
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=geoint
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CH
CLICKHOUSE_HTTP_PORT=8123

# --- Alert notifier ---
ALERT_NOTIFIER_HEALTH_PORT=8081
ALERT_NOTIFIER_READY_MAX_AGE_S=60
ALERT_NOTIFIER_POLL_SECONDS=2
ALERT_NOTIFIER_BATCH_SIZE=20
# SMTP optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@geoint.example

GEOINT_ENV_FILE=.env.staging

TRUSTED_HOSTS=localhost,127.0.0.1,staging.geoint.example
MINIO_CREATE_BUCKET=false
